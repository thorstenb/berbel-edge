{
  "domain": "berbel",
  "name": "Berbel Skyline",
  "bluetooth": [
    {
      "local_name": "SKE*",
      "connectable": true
    },
    {
      "local_name": "SKYLINE*",
      "connectable": true
    },
    {
      "local_name": "BERBEL*",
      "connectable": true
    }
