  "codeowners": ["@thorstenb"],
  "config_flow": true,
  "dependencies": ["bluetooth_adapters"],
  "documentation": "https://github.com/thorstenb/berbel-edge/README.md",
  "integration_type": "device",
  "iot_class": "local_push",
  "issue_tracker": "https://github.com/thorstenb/berbel-edge/issues",
  "requirements": ["bleak-retry-connector>=3.5.0"],
  "version": "0.1.0"
}
